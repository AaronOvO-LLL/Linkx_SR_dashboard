# 灵石解决方案工作台 · 环境变量清单
# 复制为 .env 或直接写入系统环境/服务器 EnvironmentFile。真实密钥切勿提交进 git。

# 运行模式：development（本地默认，双击 bat 即用） / production（服务器）
LS_ENV=development

# 会话签名密钥：production 下必填且不得为演示占位值，否则拒绝启动。
# 生成： python -c "import secrets; print(secrets.token_urlsafe(48))"
LS_SESSION_SECRET=

# 会话 Cookie 的 Secure 标记：仅 HTTPS 真正上线后置 true；HTTP（本地/备案前 IP 访问）保持 false。
LS_COOKIE_SECURE=false

# 监听地址/端口覆盖（可选；不填则 development 用配置 127.0.0.1:8770，production 用 0.0.0.0:8770）
LS_HOST=
LS_PORT=

# —— 大模型结构化提取（DeepSeek，OpenAI 兼容）——
DEEPSEEK_API_KEY=
# 可选覆盖：
# LS_LLM_BASE_URL=https://api.deepseek.com
# LS_LLM_MODEL=deepseek-flash

# —— 腾讯云录音转写 ASR + COS（用到录音导入才需要）——
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_COS_BUCKET=
TENCENT_COS_REGION=
TENCENT_COS_PREFIX=lingshi/asr
