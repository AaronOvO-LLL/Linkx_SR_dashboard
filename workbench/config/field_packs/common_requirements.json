  ],
  "fields": [
    {
      "key": "compliance",
      "label": "特殊合规/安全/保密要求",
      "group": "special",
      "type": "textarea",
      "required": false,
      "help": "合规、安全或保密限制，例如资料能否出园区、存储和权限要求。",
      "ai_hint": "保留客户明确提出的要求及细节。合规、安全或保密限制，例如资料能否出园区、存储和权限要求。",
      "extract": {
        "mode": "sentence",
        "keywords": [
          "合规",
          "保密",
          "安全要求",
          "不出园区",
          "本地存储",
          "权限管控"
        ],
        "negation_guard": false,
        "max_sentences": 5
      }
    },
    {
      "key": "highlights",
      "label": "亮点或标杆打造要求",
      "group": "special",
      "type": "textarea",
      "required": false,
      "help": "说明希望展示的亮点、标杆目标或验收要求。",
      "ai_hint": "保留客户明确提出的要求及细节。说明希望展示的亮点、标杆目标或验收要求。",
      "extract": {
        "mode": "sentence",
        "keywords": [
          "标杆",
          "亮点",
          "试点",
          "展示",
          "验收"
        ],
        "negation_guard": false,
        "max_sentences": 5
      }
    },
    {
      "key": "procurement",
      "label": "采购与审批要求",
      "group": "special",
      "type": "textarea",
      "required": false,
      "ai_hint": "保留客户明确提出的要求及细节。说明采购方式、审批流程、时间安排及其他限制。",
      "extract": {
        "mode": "sentence",
        "keywords": [
          "采购",
          "审批",
          "招标",
          "比价",
          "立项"
        ],
        "negation_guard": false,
        "max_sentences": 5
      },
      "help": "说明采购方式、审批流程、时间安排及其他限制。"
    }
