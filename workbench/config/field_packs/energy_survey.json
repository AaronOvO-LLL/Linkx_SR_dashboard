{
  "pack": "energy_survey",
  "name": "能源踏勘",
  "scope": "product",
  "groups": [
    {
      "key": "energy_eligibility",
      "name": "第一步：准入判断",
      "order": 0,
      "desc": "确认受支持系统与电费门槛"
    },
    {
      "key": "energy_equipment",
      "name": "第二步：设备清单",
      "order": 1,
      "desc": "仅覆盖可改造部分"
    },
    {
      "key": "energy_operation",
      "name": "第三步：运行现状",
      "order": 2,
      "desc": "10问全部选填"
    }
  ],
  "fields": [
    {
      "key": "energy_system_types",
      "label": "项目空调系统类型（可多选）",
      "group": "energy_eligibility",
      "type": "multiselect",
      "required": true,
      "options": [
        {
          "value": "水冷机组中央空调（无冰/水蓄冷）",
          "synonyms": []
        },
        {
          "value": "中央空调（带冰蓄冷或水蓄冷辅助）",
          "synonyms": []
        },
        {
          "value": "VRV（末端面板可被 BA 控制且 BA 正常运行）",
          "synonyms": []
        },
        {
          "value": "VRV（无 BA 或 BA 不正常）",
          "synonyms": []
        },
        {
          "value": "其他系统（风冷机组等）",
          "synonyms": []
        }
      ],
      "extract": {
        "mode": "enum",
        "keywords": [
          "空调",
          "水冷",
          "VRV"
        ],
        "patterns": [
          {
            "value": "水冷机组中央空调（无冰/水蓄冷）",
            "pattern": "水冷[^。\\n]*(?:无|没有|不带)(?:冰/水蓄冷|冰蓄冷|水蓄冷|蓄冷)",
            "exclude_patterns": [
              "(?<!没)(?<!不)(?:带|有)(?:冰蓄冷|水蓄冷)"
            ]
          },
          {
            "value": "中央空调（带冰蓄冷或水蓄冷辅助）",
            "pattern": "(?<!不)(?<!没)(?:带|有)(?:冰蓄冷|水蓄冷)"
          },
          {
            "value": "VRV（末端面板可被 BA 控制且 BA 正常运行）",
            "pattern": "VRV[^。\\n]*面板[^。\\n]*BA[^。\\n]*(?<!不)正常运行",
            "exclude_patterns": [
              "不能|不可|无法|不正常|无\\s*BA"
            ]
          },
          {
            "value": "VRV（无 BA 或 BA 不正常）",
            "pattern": "VRV[^。\\n]*(?:无\\s*BA|BA\\s*不正常)"
          },
          {
            "value": "其他系统（风冷机组等）",
            "pattern": "风冷机组"
          }
        ]
      },
      "ai_hint": "仅按原文选择。没有冰蓄冷不等于带蓄冷；水冷须明确无蓄冷，VRV须面板可被BA控制且BA正常。混合系统可多选，未知不推断。"
    },
    {
      "key": "energy_fee_over_1m",
      "label": "可改造部分的空调电费是否大于100万？",
      "group": "energy_eligibility",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "是"
        },
        {
          "value": "否"
        }
      ],
      "extract": {
        "mode": "enum",
        "keywords": [
          "空调电费"
        ],
        "patterns": [
          {
            "value": "是",
            "pattern": "可改造部分[^。\\n]*电费(?:大于|超过)100万"
          },
          {
            "value": "否",
            "pattern": "可改造部分[^。\\n]*电费(?:不大于|不超过|小于|等于)100万"
          }
        ]
      },
      "ai_hint": "只判断可改造部分；不明确口径或金额时留空。大于100万为是，否则为否。"
    },
    {
