{
  "pack": "security_business",
  "name": "安全业务与重点",
  "scope": "product",
  "desc": "当前管理模式、痛点、期望与重点位置算法",
  "groups": [
    {
      "key": "business",
      "name": "安全业务踏勘",
      "order": 8,
      "desc": "当前管理模式、人员、问题与期望"
    },
    {
      "key": "keypoints",
      "name": "预期重点位置",
      "order": 10,
      "desc": "重点位置、事件与算法"
    }
