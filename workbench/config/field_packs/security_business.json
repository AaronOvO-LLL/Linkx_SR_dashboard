      "group": "business",
      "type": "textarea",
      "required": false,
      "help": "保安/安全员人数、班次",
      "ai_hint": "提取现有安保人员数量、班次与岗位安排",
      "extract": {
        "mode": "sentence",
        "keywords": [
          "保安",
          "门卫",
          "安保",
