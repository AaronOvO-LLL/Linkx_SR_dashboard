      "key": "current_mode",
      "label": "当前安全管理模式",
      "group": "business",
      "type": "textarea",
      "required": false,
      "help": "现在是靠人巡、靠物业，还是已有外包",
      "ai_hint": "概括客户当前的安全管理方式，保留关键事实",
      "extract": {
        "mode": "sentence",
        "keywords": [
          "现在",
          "目前",
          "当前",
          "保安",
          "物业",
          "巡检",
          "值班",
          "人防",
          "没有系统",
          "人工"
        ]
      }
    },
    {
