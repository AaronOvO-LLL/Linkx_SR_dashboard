{
  "pack": "fire_survey",
  "name": "消防现状踏勘",
  "scope": "product",
  "groups": [
    {
      "key": "fire_control",
      "name": "消控室情况",
      "order": 4
    },
    {
      "key": "fire_maintenance",
      "name": "项目维保单位信息",
      "order": 5
    },
    {
      "key": "fire_cost",
      "name": "一次性改造费用",
      "order": 6
    }
  ],
  "fields": [
    {
      "key": "fire_control_count",
      "label": "消控中心数量",
      "group": "fire_control",
      "type": "number",
      "required": true,
      "source": "踏勘要求的项目具体内容.xlsx / Sheet1 / 行63",
      "extract": {
        "mode": "number",
        "keywords": [
          "消控中心数量",
          "消控中心",
          "消控室"
        ],
        "negation_guard": false,
        "unit_hint": "个"
      },
      "unit": "个",
      "validate": {
        "min": 0,
        "message": "消控中心数量不能为负数"
      }
    },
    {
      "key": "fire_signal_transmission",
      "label": "消控室是否可分控或信号传输",
      "group": "fire_control",
      "type": "select",
      "required": true,
      "source": "踏勘要求的项目具体内容.xlsx / Sheet1 / 行64",
      "extract": {
        "mode": "enum",
        "keywords": [
          "分控",
          "信号传输",
          "主消控室"
        ],
        "context_keywords": [
          "分控",
          "信号传输",
          "主消控室"
        ],
        "fallback_text": true,
        "negation_guard": false,
        "prefer_longest_match": true
      },
      "options": [
        {
          "value": "可分控且可传输信号",
          "synonyms": [
            "可以分控并传输信号"
          ]
        },
        {
          "value": "仅可分控",
          "synonyms": [
            "只能分控"
          ]
        },
        {
          "value": "仅可传输信号",
          "synonyms": [
            "只能传输信号"
          ]
        },
        {
          "value": "均不支持",
          "synonyms": [
            "不能分控也不能传输信号",
            "不支持分控和信号传输"
          ]
        },
        {
          "value": "待确认",
          "synonyms": [
            "分控情况待确认",
            "信号传输待确认"
          ]
        }
      ],
      "allow_custom": true,
      "help": "按现场核查选择；多个消控室情况不同或需描述主从关系时，请选择“其他 / 详细说明”逐项填写。",
      "ai_hint": "按现场核查选择；多个消控室情况不同或需描述主从关系时，请选择“其他 / 详细说明”逐项填写。 优先使用候选项；选项无法表达的具体事实可保留原文，不得推测。"
    },
    {
      "key": "fire_host_relationships",
      "label": "消防主机数量及主从关系",
      "group": "fire_control",
      "type": "textarea",
      "required": true,
      "source": "踏勘要求的项目具体内容.xlsx / Sheet1 / 行65-66",
      "extract": {
        "mode": "sentence",
        "keywords": [
          "消防主机数量",
          "主从",
          "主机",
          "主消控室"
        ],
        "negation_guard": false,
        "max_sentences": 1000
      },
      "help": "有几个消控室就填写几行，每行注明消控室编号及对应主机信息。",
      "ai_hint": "逐个消控室保留编号、主机信息及主从关系，每个消控室一行，不得合并遗漏。"
    },
    {
      "key": "fire_host_brands",
