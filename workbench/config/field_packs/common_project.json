{
  "pack": "common_project",
  "name": "项目基本情况",
  "scope": "common",
  "desc": "项目名称、来源、业态、规模、地址——全部「管家」类产品共用",
  "groups": [
    {
      "key": "basic",
      "name": "项目基本情况",
      "order": 1,
      "desc": "项目名称、来源、业态、建设类型与规模"
    }
  ],
  "fields": [
    {
      "key": "project_name",
      "label": "项目名称",
      "group": "basic",
      "type": "text",
      "required": true,
      "help": "被服务项目的正式名称",
      "placeholder": "例如：新宇精密产业园",
      "ai_hint": "提取项目或厂区/园区的正式名称",
      "extract": {
        "mode": "entity",
        "keywords": [
          "项目名称",
          "厂区名称",
          "园区名称",
          "项目",
          "厂区",
          "园区"
        ],
        "entity_suffix": [
          "园",
          "区",
          "厂",
          "大厦",
          "中心",
          "基地",
          "项目",
          "城",
          "馆"
        ]
      }
    },
    {
      "key": "project_source",
      "label": "项目来源",
      "group": "basic",
      "type": "select",
      "required": true,
      "help": "内部项目、外部项目或重点项目",
      "options": [
        {
          "value": "内部项目",
          "synonyms": [
            "内部",
            "自有项目"
          ]
        },
        {
          "value": "外部项目",
          "synonyms": [
            "外部",
            "对外项目"
          ]
        },
        {
          "value": "重点项目",
          "synonyms": [
            "重点",
            "标杆项目"
          ]
        }
      ],
      "ai_hint": "判断项目是内部、外部还是重点项目",
      "extract": {
        "mode": "enum"
      }
    },
    {
      "key": "business_type",
      "label": "项目业态",
      "group": "basic",
      "type": "select",
      "required": true,
      "help": "影响方案模板与风险画像",
      "options": [
        {
          "value": "园区",
          "synonyms": [
            "工业园",
            "产业园",
            "园区",
            "厂区",
            "制造基地"
          ]
        },
        {
          "value": "住区",
          "synonyms": [
            "小区",
            "住宅",
            "社区",
            "公寓",
            "居民区"
          ]
        },
        {
          "value": "城区",
          "synonyms": [
            "城区",
            "城区治理",
            "街道"
          ]
        },
        {
          "value": "公园",
          "synonyms": [
            "公园",
            "景区",
            "绿地"
          ]
        },
        {
          "value": "酒店",
          "synonyms": [
            "酒店",
            "宾馆",
            "旅馆"
          ]
        },
        {
          "value": "医疗",
          "synonyms": [
            "医院",
            "诊所",
            "门诊",
            "医疗"
          ]
        },
        {
          "value": "学校",
          "synonyms": [
            "学校",
            "学院",
            "大学",
            "校园",
            "校区"
          ]
        },
        {
          "value": "商业",
          "synonyms": [
            "商业",
            "商场",
            "购物中心",
            "综合体",
            "写字楼",
            "办公楼"
          ]
        },
        {
          "value": "其他",
          "synonyms": []
        }
      ],
      "ai_hint": "按场所实际用途判断业态",
      "extract": {
        "mode": "enum"
      }
    },
    {
      "key": "build_type",
      "label": "项目建设类型",
      "group": "basic",
      "type": "select",
      "required": true,
      "options": [
        {
          "value": "新建",
          "synonyms": [
            "新建",
            "新项目",
            "刚建"
          ]
        },
        {
          "value": "旧改",
          "synonyms": [
            "旧改",
            "改造",
            "改建",
            "翻新",
            "存量"
          ]
        }
      ],
      "ai_hint": "判断项目是新建还是旧改",
      "extract": {
        "mode": "enum"
      }
    },
    {
      "key": "land_area",
      "label": "占地面积",
      "group": "basic",
      "type": "number",
      "required": true,
      "unit": "m²",
      "help": "项目总占地，用于点位密度与范围测算",
      "ai_hint": "提取占地面积数字，统一为平方米",
      "extract": {
        "mode": "number",
        "keywords": [
          "占地",
          "用地面积",
          "土地面积"
        ],
        "unit_hint": "m²"
      }
    },
    {
      "key": "building_area",
      "label": "建筑面积",
      "group": "basic",
      "type": "number",
      "required": true,
      "unit": "m²",
      "help": "用于点位密度与费用测算",
      "validate": {
        "min": 0,
        "message": "建筑面积不能为负数"
      },
      "ai_hint": "提取建筑面积数字及单位，统一换算为平方米",
      "extract": {
        "mode": "number",
        "keywords": [
          "建筑面积",
          "总面积",
          "平米",
          "平方米",
          "平方",
          "m²",
          "m2"
        ],
        "unit_hint": "m²"
      }
    },
    {
      "key": "site_address",
      "label": "项目地址",
      "group": "basic",
      "type": "text",
      "required": true,
      "help": "用于实施范围与差旅测算",
      "ai_hint": "提取项目所在的市、区、路名、门牌号",
      "extract": {
        "mode": "entity",
        "keywords": [
          "地址",
          "位于",
          "坐落于",
          "路",
          "区",
          "号"
        ],
        "entity_suffix": [
          "号",
          "路",
          "街",
          "区",
          "镇",
          "村",
          "大道",
          "工业园",
          "产业园"
        ]
      }
    }
  ]
}
