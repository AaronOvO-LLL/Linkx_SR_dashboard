      "key": "has_internet",
      "label": "是否具备外网条件",
      "group": "network",
      "type": "select",
      "required": true,
      "remark": "如果没有外网，无法使用工单系统，价值卡片会有影响",
      "options": [
        {
          "value": "有",
          "synonyms": [
            "有外网",
            "可以上网",
            "有网",
            "外网",
            "能上网",
            "有宽带"
          ]
        },
        {
          "value": "无",
          "synonyms": [
            "无外网",
            "没有网",
            "没网",
            "不能上网",
            "纯内网"
          ]
        }
      ],
      "ai_hint": "判断现场是否具备外网条件",
      "extract": {
        "mode": "enum"
      }
    },
    {
