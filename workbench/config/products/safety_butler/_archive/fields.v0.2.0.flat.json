      "ai_hint": "判断客户是否已提供图纸",
      "extract": {"mode": "enum"}
    },
    {
      "key": "equipment_ledger", "label": "设备台账", "group": "docs", "type": "select", "required": false,
      "help": "项目所有机电设备清单",
      "options": [
        {"value": "有", "synonyms": ["有台账", "设备清单", "台账有"]},
        {"value": "无", "synonyms": ["没有台账", "无台账"]}
