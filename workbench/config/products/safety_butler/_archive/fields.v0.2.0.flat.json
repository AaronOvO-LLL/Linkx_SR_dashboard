      "remark": "强电图纸、弱电图纸、暖通图纸、给排水图纸，要求是竣工图或终版施工图",
      "options": [
        {"value": "有", "synonyms": ["有图纸", "图纸有", "已经提供", "CAD", "cad", "竣工图"]},
        {"value": "无", "synonyms": ["没有图", "缺图", "没图纸", "无图纸"]}
