# 灵石解决方案工作台 · 服务器环境变量示例
# 用法：复制为 /etc/lingshi/lingshi.env，填入真实值，并执行 chmod 600。
# 切勿把填好的真实文件提交进 git。

# 运行模式：生产必须为 production（缺失会话密钥会拒绝启动）
LS_ENV=production

# 会话 Cookie 的 Secure 标记：仅在 HTTPS 真正上线后（阶段二）改为 true。
# 阶段一是 HTTP（IP:8770），必须保持 false，否则登录后会立即掉线。
LS_COOKIE_SECURE=false

# 会话签名密钥：必填，强随机值。生成命令：
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
LS_SESSION_SECRET=请替换为强随机字符串

# —— 大模型结构化提取（DeepSeek，OpenAI 兼容）——
DEEPSEEK_API_KEY=你的DeepSeek密钥
# 可选覆盖项（不填用 config/app.json 默认）：
# LS_LLM_BASE_URL=https://api.deepseek.com
# LS_LLM_MODEL=deepseek-flash

# —— 腾讯云录音转写 ASR + COS（用到录音导入功能才需要）——
TENCENTCLOUD_SECRET_ID=你的SecretId
TENCENTCLOUD_SECRET_KEY=你的SecretKey
TENCENT_COS_BUCKET=你的存储桶名（如 examplebucket-1250000000）
TENCENT_COS_REGION=存储桶地域（如 ap-guangzhou）
TENCENT_COS_PREFIX=lingshi/asr
